[Unit]
Description=Toaster Systems backend
After=multi-user.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/lttd/toasterSystems/toasterSystems
ExecStart=/usr/bin/python3 -u /home/lttd/toasterSystems/toasterSystems/main.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target